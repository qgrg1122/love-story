<!DOCTYPE html>
 <html lang="zh-CN">
 <head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>love</title>
 <style>
 * {
   margin: 0;
   padding: 0;
   box-sizing: border-box;
   font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
 }
 body {
   background: #fdf6f8;
   max-width: 480px;
   margin: 0 auto;
   height: 100vh;
   display: flex;
   flex-direction: column;
   overflow: hidden;
 }
 /* 顶部固定 */
 .header {
   background: #f8d7e4;
   padding: 10px 15px;
   display: flex;
   align-items: center;
   justify-content: center;
   position: sticky;
   top: 0;
   z-index: 10;
 }
 .avatar {
   width: 32px;
   height: 32px;
   border-radius: 50%;
   background: #ffb6c1;
   margin-right: 10px;
 }
 .info {
   text-align: center;
 }
 .name {
   font-size: 15px;
   font-weight: 500;
   color: #333;
 }
 .status {
   font-size: 11px;
   color: #999;
 }
 /* 消息区域 */
 .chat-box {
   flex: 1;
   padding: 10px 12px;
   overflow-y: auto;
   background: #fef8fb;
 }
 .chat-box::-webkit-scrollbar {
   width: 3px;
 }
 .chat-box::-webkit-scrollbar-thumb {
   background: rgba(247, 178, 194, 0.5);
   border-radius: 3px;
 }
 /* 消息气泡 */
 .message {
   margin-bottom: 8px;
   display: flex;
   max-width: 75%;
 }
 .you {
   justify-content: flex-end;
   margin-left: auto;
 }
 .other {
   justify-content: flex-start;
 }
 .bubble {
   padding: 6px 10px;
   border-radius: 12px;
   font-size: 14px;
   line-height: 1.4;
   background: rgba(255, 255, 255, 0.8);
   border: 1px solid #f5d5e2;
 }
 .you .bubble {
   background: rgba(252, 228, 236, 0.8);
 }
 /* 输入框固定底部 */
 .input-area {
   display: flex;
   padding: 8px 10px;
   background: #fff;
   border-top: 1px solid #f5e4ee;
   position: sticky;
   bottom: 0;
   z-index: 10;
 }
 input {
   flex: 1;
   border: 1px solid #f8d7e4;
   border-radius: 18px;
   padding: 7px 12px;
   font-size: 14px;
   outline: none;
   background: #fff;
 }
 button {
   margin-left: 8px;
   border: none;
   background: #f8b3c6;
   color: #fff;
   border-radius: 18px;
   padding: 0 14px;
   font-size: 14px;
   cursor: pointer;
 }
 button:hover {
   background: #f8a1b7;
 }
 </style>
 </head>
 <body>
 <div class="header">
   <div class="avatar"></div>
   <div class="info">
     <div class="name">我的爱人</div>
     <div class="status">在线</div>
   </div>
 </div>
 <div class="chat-box" id="chatBox"></div>
 <div class="input-area">
   <input id="msgInput" placeholder="说点什么..." autocomplete="off">
   <button onclick="send()">发送</button>
 </div>
 <script>
 // 你可以在这里自定义对方所有回复词条
 const replyWords = [
   "嗯呐",
   "好想你",
   "我一直在",
   "乖乖的",
   "爱你哟",
   "知道啦",
   "抱抱你",
   "今天也要开心",
   "摸摸头",
   "我都听你的"
 ];
 const chatBox = document.getElementById('chatBox');
 const input = document.getElementById('msgInput');
 function send() {
   let text = input.value.trim();
   if (!text) return;
   addMsg(text, 'you');
   input.value = '';
   setTimeout(autoReply, 600);
 }
 function autoReply() {
   let count = Math.floor(Math.random() * 3) + 1;
   let selected = [];
   for (let i = 0; i < count; i++) {
     let r = replyWords[Math.floor(Math.random() * replyWords.length)];
     selected.push(r);
   }
   addMsg(selected.join(' '), 'other');
 }
 function addMsg(text, who) {
   let div = document.createElement('div');
   div.className = 'message ' + who;
   let bubble = document.createElement('div');
   bubble.className = 'bubble';
   bubble.innerText = text;
   div.appendChild(bubble);
   chatBox.appendChild(div);
   chatBox.scrollTop = chatBox.scrollHeight;
 }
 input.addEventListener('keydown', e => {
   if (e.key === 'Enter') send();
 });
 </script>
 </body>
 </html>
