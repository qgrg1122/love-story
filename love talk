<!DOCTYPE html>
 <html lang="zh-CN">
 <head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>love</title>
 <style>
 * {
   margin: 0;
   padding: 0;
   box-sizing: border-box;
   font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
 }
 body {
   background: #fdf6f8;
   max-width: 480px;
   margin: 0 auto;
   height: 100vh;
   display: flex;
   flex-direction: column;
   overflow: hidden;
 }
 /* 顶部固定栏 */
 .header {
   background: #f8d7e4;
   padding: 8px 15px;
   display: flex;
   align-items: center;
   justify-content: center;
   position: fixed;
   top: 0;
   width: 100%;
   max-width: 480px;
   z-index: 10;
   border-bottom: 1px solid #f0c8d5;
 }
 .avatar {
   width: 30px;
   height: 30px;
   border-radius: 50%;
   background: #ffb6c1;
   margin-right: 8px;
 }
 .info {
   text-align: center;
 }
 .name {
   font-size: 14px;
   font-weight: 500;
   color: #333;
 }
 .status {
   font-size: 10px;
   color: #888;
 }
 /* 消息区域 */
 .chat-box {
   flex: 1;
   padding: 10px 12px;
   margin-top: 47px;
   margin-bottom: 50px;
   overflow-y: auto;
   background: #fef8fb;
 }
 /* 滚动条样式 */
 .chat-box::-webkit-scrollbar {
   width: 3px;
 }
 .chat-box::-webkit-scrollbar-thumb {
   background: rgba(247, 178, 194, 0.5);
   border-radius: 3px;
 }
 /* 消息气泡 */
 .message {
   margin-bottom: 6px;
   display: flex;
   max-width: 78%;
 }
 .you {
   justify-content: flex-end;
 }
 .other {
   justify-content: flex-start;
 }
 .bubble {
   padding: 5px 9px;
   border-radius: 11px;
   font-size: 13px;
   line-height: 1.35;
   background: rgba(255, 255, 255, 0.8);
   border: 1px solid #f5d5e2;
   word-wrap: break-word;
 }
 .you .bubble {
   background: rgba(252, 228, 236, 0.8);
 }
 /* 输入框区域 */
 .input-area {
   display: flex;
   padding: 7px 10px;
   background: #fff;
   border-top: 1px solid #f5e4ee;
   position: fixed;
   bottom: 0;
   width: 100%;
   max-width: 480px;
   z-index: 10;
 }
 input {
   flex: 1;
   border: 1px solid #f8d7e4;
   border-radius: 17px;
   padding: 6px 12px;
   font-size: 13px;
   outline: none;
   background: #fff;
 }
 button {
   margin-left: 7px;
   border: none;
   background: #f8b3c6;
   color: #fff;
   border-radius: 17px;
   padding: 0 13px;
   font-size: 13px;
   cursor: pointer;
 }
 button:hover {
   background: #f8a1b7;
 }
 </style>
 </head>
 <body>
 <div class="header">
   <div class="avatar"></div>
   <div class="info">
     <div class="name">我的爱人</div>
     <div class="status">永远在线</div>
   </div>
 </div>
 <div class="chat-box" id="chatBox"></div>
 <div class="input-area">
   <input id="msgInput" placeholder="输入想说的话..." autocomplete="off">
   <button onclick="send()">发送</button>
 </div>
 <script>
 const replyWords = [
   "我在呢",
   "好喜欢你",
   "今天过得开心吗？",
   "抱抱",
   "遵命～",
   "想你了",
   "真乖",
   "我们要一直在一起"
 ];
 const chatBox = document.getElementById('chatBox');
 const input = document.getElementById('msgInput');
 function send() {
   let text = input.value.trim();
   if (!text) return;
   addMsg(text, 'you');
   input.value = '';
   setTimeout(autoReply, 800);
 }
 function autoReply() {
   const count = Math.floor(Math.random() * 3) + 1;
   let replyText = "";
   for (let i = 0; i < count; i++) {
     const randomIdx = Math.floor(Math.random() * replyWords.length);
     replyText += replyWords[randomIdx] + (i < count - 1 ? '  ' : '');
   }
   addMsg(replyText, 'other');
 }
 function addMsg(text, who) {
   const div = document.createElement('div');
   div.className = `message ${who}`;
   
   const bubble = document.createElement('div');
   bubble.className = 'bubble';
   bubble.innerText = text;
   
   div.appendChild(bubble);
   chatBox.appendChild(div);
   
   chatBox.scrollTop = chatBox.scrollHeight;
 }
 input.addEventListener('keydown', (e) => {
   if (e.key === 'Enter' && !e.shiftKey) {
     e.preventDefault();
     send();
   }
 });
 window.onload = () => {
   setTimeout(() => {
     addMsg("欢迎来到我们的秘密花园～", 'other');
   }, 500);
 };
 </script>
 </body>
 </html>
